      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DHMP.AspNetCore/DHMP.AspNetCore.csproj" />
    <ProjectReference Include="../../src/DHMP.Client/DHMP.Client.csproj" />
    <ProjectReference Include="../../src/DHMP.Server/DHMP.Server.csproj" />
  </ItemGroup>
